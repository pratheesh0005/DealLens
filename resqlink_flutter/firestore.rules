rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped wishlist collection: users/{userId}/wishlist/{productId}
    match /users/{userId}/wishlist/{productId} {
      // Allow authenticated users to manage their own wishlist
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow guest/device access for unauthenticated sessions
      allow read, write: if request.auth == null;
    }
  }
}